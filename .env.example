# 复制为 .env 并填真值。.env 不入库。

# === 韩国住宅代理（抓 LV 用）===
# 格式 http://用户名:密码@host:port
LV_PROXY=http://user:pass@kr-residential.example.com:8000

# === 得物开放平台 open.poizon.com ===
# 在 控制台 > 应用管理 > 我的应用 > 应用详情 获取
DEWU_APP_KEY=
DEWU_APP_SECRET=
# ISV/部分接口需要；自营商家可全局配置
DEWU_ACCESS_TOKEN=
# 网关地址（核实后填，海外 open.poizon / 国内 openapi.dewu.com）
DEWU_API_BASE=https://openapi.dewu.com
